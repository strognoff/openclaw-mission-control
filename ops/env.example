# /etc/menuboard/mission-control.env — example env file used by the systemd
# units. Permissions: 0640 owned by root:menuboard.
#
# Generate a fresh admin key with:
#   node -e "console.log('MC_ADMIN_KEY=' + require('crypto').randomBytes(32).toString('hex'))"

MC_ADMIN_KEY=change-me-please-this-is-a-32-byte-hex-string-please
MC_API_URL=https://api.menuboard.online/v1/agents
MC_DATABASE_URL=file:/var/lib/menuboard/mission-control/dev.db

# Reasonable production defaults; tweak as needed.
MC_HOST=127.0.0.1
MC_PORT=8787
MC_LOG_LEVEL=info
MC_HEARTBEAT_INTERVAL_MS=30000
MC_OFFLINE_AFTER_MS=90000
MC_REAPER_INTERVAL_MS=10000
MC_RETENTION_DAYS=30
MC_RETENTION_INTERVAL_MS=3600000
MC_RETENTION_LOCKFILE=/var/lib/menuboard/mission-control/retention.lock
MC_CORS_ORIGINS=https://menuboard.online

# Dashboard uses the same MC_ADMIN_KEY for its admin-authenticated reads.
# The dashboard reads the env var on the SERVER side. The browser only sees
# the key via the EventSource ?token= URL; that token is the SAME admin key.