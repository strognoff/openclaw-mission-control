# Mission Control dashboard — example env. Copy to .env for local dev.

# URL of the Mission Control API (no trailing slash).
MC_API_URL=http://127.0.0.1:8787/v1/agents

# Admin API key (must match MC_ADMIN_KEY on the API side).
MC_ADMIN_KEY=change-me-please-this-is-a-32-byte-hex-string-please

# Public base path the dashboard is served under. Defaults to /agents.
MC_DASHBOARD_BASE_PATH=/agents