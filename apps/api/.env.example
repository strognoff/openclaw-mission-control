# Mission Control API — example env. Copy to .env and edit for local dev.
# Production: every value below is overridable via the OS environment.

# Listen address
MC_HOST=0.0.0.0
MC_PORT=8787
MC_LOG_LEVEL=info

# Bootstrap admin key — used to mint per-agent keys. CHANGE THIS.
# Generate a fresh one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MC_ADMIN_KEY=change-me-please-this-is-a-32-byte-hex-string-please

# Prisma / SQLite
MC_DATABASE_URL=file:./prisma/dev.db

# Retention
MC_RETENTION_DAYS=30
MC_RETENTION_INTERVAL_MS=3600000
MC_RETENTION_LOCKFILE=/tmp/menuboard-agents-api.retention.lock

# Offline detection
MC_HEARTBEAT_INTERVAL_MS=30000
MC_OFFLINE_AFTER_MS=90000
MC_REAPER_INTERVAL_MS=10000

# CORS — comma-separated origins, or "*"
MC_CORS_ORIGINS=*

# Where the dashboard fetches SSE from. Used for CORS + cache hints.
MC_PUBLIC_BASE_URL=https://api.menuboard.online/v1/agents